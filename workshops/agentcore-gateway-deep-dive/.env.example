# AgentCore Gateway — environment variables for local agent development
# Copy to .env and fill in values after running `make deploy-infra`

# Gateway MCP endpoint (from tmp/gateway_url.txt after deploy)
GATEWAY_URL=

# Cognito M2M credentials (from tmp/cognito_*.txt after deploy)
COGNITO_TOKEN_ENDPOINT=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=gateway/read

# Model override (optional — defaults to ap.anthropic.claude-sonnet-4-6)
# MODEL_ID=ap.anthropic.claude-sonnet-4-6
